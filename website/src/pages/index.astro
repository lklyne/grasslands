---
import Base from '../layouts/Base.astro'
import { GITHUB_URL, HERDR_URL, HERDR_VERSION, INSTALL_COMMAND } from '../lib/site'
---

<Base>
  <main>
    <header class="masthead">
      <h1><span class="wordmark">Grasslands</span> <span class="muted"><span class="fleuron" aria-hidden="true">≈</span> a place for herding agents</span></h1>
      <a class="github" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="grasslands on GitHub (opens in a new tab)">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
    </header>
    <p>
      A native app that builds on <a href={HERDR_URL}>herdr</a>, adding a simple file browser, diffs, and some interface improvements like panel management. No extra setup. It just syncs and works.
    </p>

    <h2>Install</h2>
    <div class="install">
      <pre id="install-command">{INSTALL_COMMAND}</pre>
      <button type="button" data-copy="install-command" aria-live="polite" hidden>Copy</button>
    </div>
    <p class="muted requires">Requires macOS and <a href={HERDR_URL}>herdr</a> {HERDR_VERSION}.</p>

    <h2>What it does</h2>
    <ul>
      <li>Reuses and syncs your existing <a href={HERDR_URL}>herdr</a> setup.</li>
      <li>Adds a file browser, diffs and an editor.</li>
      <li>Built with <a href="https://www.rust-lang.org">Rust</a> and <a href="https://gpui.rs">GPUI</a>, so it's fast.</li>
      <li>Drag-and-drop layout.</li>
      <li>Command palette.</li>
      <li>No other fluff.</li>
    </ul>

    <img
      class="meadow meadow-day"
      src="/meadow.webp"
      width="1152"
      height="735"
      alt="A painted meadow of tall green grass under a band of clouds"
      loading="lazy"
      decoding="async"
    />
    <img
      class="meadow meadow-night"
      src="/meadow-night.webp"
      width="1152"
      height="735"
      alt="A painted meadow of tall green grass under clouds and stars at night"
      loading="lazy"
      decoding="async"
    />
  </main>

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      const source = document.getElementById(button.dataset.copy ?? '')
      if (!source || !navigator.clipboard) continue
      button.hidden = false
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(source.textContent ?? '')
          button.textContent = 'Copied'
        } catch {
          button.textContent = 'Copy failed'
        }
        setTimeout(() => (button.textContent = 'Copy'), 1500)
      })
    }
  </script>
</Base>
