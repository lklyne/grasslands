---
import { Font } from 'astro:assets'
import '../styles/global.css'
import { AUTHOR_URL, GITHUB_URL, LICENSE_URL } from '../lib/site'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const {
  title = 'grasslands, a native macOS app for herdr',
  description = 'A native macOS app that adds a file browser, diffs and panel management to herdr.',
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-garamond" preload />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="grasslands" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <slot />
    <footer>
      <span>
        <button type="button" class="theme-toggle" aria-label="Switch to dark mode" hidden>
          <svg class="moon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z" />
          </svg>
          <svg class="sun" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
            <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z" />
          </svg>
        </button> · <a href={GITHUB_URL}>GitHub</a> · <a href={LICENSE_URL}>MIT</a>
      </span>
      <span>Made with ♥ by <a href={AUTHOR_URL}>Lyle Klyne</a></span>
    </footer>
    <script>
      const root = document.documentElement
      const dark = matchMedia('(prefers-color-scheme: dark)')
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle')
      const isDark = () => (root.dataset.theme ?? (dark.matches ? 'dark' : 'light')) === 'dark'
      const label = () => {
        button?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode')
      }
      if (button) {
        button.hidden = false
        label()
        dark.addEventListener('change', label)
        button.addEventListener('click', () => {
          const theme = isDark() ? 'light' : 'dark'
          root.dataset.theme = theme
          try {
            localStorage.setItem('theme', theme)
          } catch {}
          label()
        })
      }
    </script>
  </body>
</html>
