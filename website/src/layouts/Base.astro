---
import { Font } from 'astro:assets'
import '../styles/global.css'
import { GITHUB_URL, LICENSE_URL } from '../lib/site'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const {
  title = 'grasslands, a native macOS app for herdr',
  description = 'A native macOS app that adds a file browser, diffs and panel management to herdr.',
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-garamond" preload />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="grasslands" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <slot />
    <footer>
      <a href="/">grasslands</a> · <a href={GITHUB_URL}>GitHub</a> · <a href={LICENSE_URL}>MIT</a>
    </footer>
  </body>
</html>
