import { describe, expect, it } from "vitest";
import { quoteStay } from "@/lib/pricing";

const cabin = {
  slug: "sea-ranch-a-frame",
  name: "Sea Ranch A-Frame",
  town: "The Sea Ranch",
  tz: "America/Los_Angeles",
  photo: "/a-frame.jpg",
