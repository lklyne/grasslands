#!/usr/bin/env bash
# Stages a believable herdr session for screenshots: three fake projects with
# real git history (branches, worktrees, ahead/behind, uncommitted edits) and
# agents parked in every state. Panes show canned transcripts from
# scripts/demo/*.txt; nothing real runs.
#
#   scripts/demo-scene                 # (re)build the scene
#   RT_SESSION=demo-scene scripts/dev-run cargo run -p app
#
# Uses its own herdr session (demo-scene, override with RT_SESSION) and
# rebuilds the projects under ~/.local/share/grasslands-herdr/demo each run.
set -euo pipefail

export RT_SESSION="${RT_SESSION:-demo-scene}"
here=$(cd "$(dirname "$0")" && pwd)
. "$here/dev-env.sh"
case "$HERDR_SESSION" in
  default|"") echo "demo-scene: refusing to run against the live session" >&2; exit 1 ;;
esac

herdr() { "$here/herdr-dev" "$@"; }
demo="$XDG_CONFIG_HOME/demo"
projects="$demo/projects"
remotes="$demo/remotes"
show="$here/demo/show"

# --- repos ---------------------------------------------------------------

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
day=$(( $(date +%s) - 9 * 86400 ))
commit() { # commit <author> <hours after day0> <message>
  local name=$1 when=$(( day + $2 * 3600 )) msg=$3
  local email
  email="$(printf '%s' "${name%% *}" | tr '[:upper:]' '[:lower:]')@example.com"
  git add -A
  GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="@$when" \
    GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="@$when" \
    git commit -qm "$msg"
}
put() { mkdir -p "$(dirname "$1")"; cat >"$1"; }
init_repo() { # init_repo <name>: fresh repo with a bare origin
  rm -rf "${projects:?}/$1" "${remotes:?}/$1.git"
  mkdir -p "$projects/$1" "$remotes"
  git init -q --bare -b main "$remotes/$1.git"
  cd "$projects/$1"
  git init -q -b main
  git remote add origin "$remotes/$1.git"
}

