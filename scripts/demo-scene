  commit "Maya Okafor" 3 "feat: listings grid and booking card"
  put src/lib/dates.ts <<'EOF'
import { differenceInCalendarDays, format } from "date-fns";

export function differenceInNights(checkIn: Date, checkOut: Date): number {
  return differenceInCalendarDays(checkOut, checkIn);
}

export function toDateKey(date: Date): string {
  return format(date, "yyyy-MM-dd");
}

export function isWeekendNight(date: Date): boolean {
  const day = date.getDay();
  return day === 5 || day === 6;
}
EOF
  put src/lib/pricing.ts <<'EOF'
import type { Listing } from "./listings";
import { differenceInNights, isWeekendNight } from "./dates";

const SERVICE_RATE = 0.12;
const WEEKEND_MARKUP = 1.15;

export type Quote = {
  nights: number;
  total: number;
};

export function nightlyRate(listing: Listing, night: Date): number {
  const rate = listing.baseRate;
  return isWeekendNight(night) ? Math.round(rate * WEEKEND_MARKUP) : rate;
}

export function quoteStay(listing: Listing, checkIn: Date, checkOut: Date): Quote {
  const nights = differenceInNights(checkIn, checkOut);
  const rate = nightlyRate(listing, checkIn);
  const serviceFee = Math.round(nights * rate * SERVICE_RATE);
  return { nights, total: nights * rate + listing.cleaningFee + serviceFee };
}
EOF
  commit "Theo Lindqvist" 26 "feat(pricing): nightly quotes with weekend markup"
  put src/app/checkout/page.tsx <<'EOF'
import { quoteStay } from "@/lib/pricing";
import { getListing } from "@/lib/listings";

type Props = { searchParams: Promise<{ listing: string; from: string; to: string }> };

export default async function Checkout({ searchParams }: Props) {
  const { listing: slug, from, to } = await searchParams;
  const listing = await getListing(slug);
  const quote = quoteStay(listing, new Date(from), new Date(to));

  return (
    <main className="checkout">
      <h1>{listing.name}</h1>
      <p>
        {quote.nights} nights · <strong>${quote.total}</strong>
      </p>
      <button type="submit">Reserve</button>
    </main>
  );
}
