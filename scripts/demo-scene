import re
p = "src/lib/pricing.ts"
s = open(p).read()
s = s.replace("""export type Quote = {
  nights: number;
  total: number;
};""", """export type LineItem = {
  kind: "nights" | "cleaning" | "service";
  label: string;
  amount: number;
};

export type Quote = {
  nights: number;
  items: LineItem[];
  total: number;
};""")
s = s.replace("""  return { nights, total: nights * rate + listing.cleaningFee + serviceFee };""",
"""  const items: LineItem[] = [
    { kind: "nights", label: nightsLabel(nights), amount: nights * rate },
    { kind: "cleaning", label: "Cleaning fee", amount: listing.cleaningFee },
    { kind: "service", label: "Service fee", amount: serviceFee },
  ];
  return { nights, items, total: sum(items.map((i) => i.amount)) };
}

function nightsLabel(nights: number): string {
  return nights === 1 ? "1 night" : `${nights} nights`;
}

function sum(values: number[]): number {
  return values.reduce((a, b) => a + b, 0);""")
open(p, "w").write(s)
EOF
