EOF
  put README.md <<'EOF'
# ferrous

A sharded in-memory cache for Rust services that don't want a network hop.

```rust
let cache = ferrous::Cache::builder().capacity(1 << 20).shards(16).build();
cache.set("session:42", payload);
```

LRU by default; LFU and TTL eviction behind `Policy`.
EOF
  put .gitignore <<'EOF'
/target
EOF
  put src/lib.rs <<'EOF'
//! A sharded in-memory cache.

mod lru;
mod shard;
mod ttl;

pub use shard::{Cache, CacheBuilder};

/// How a full shard picks what to drop.
#[derive(Clone, Copy, Debug, Default)]
pub enum Policy {
    #[default]
    Lru,
    Lfu,
    Ttl(std::time::Duration),
}
EOF
  put src/shard.rs <<'EOF'
use std::hash::{BuildHasher, Hash};

use ahash::RandomState;
use parking_lot::Mutex;

use crate::{Policy, lru::Lru};

pub struct Cache<K, V> {
    shards: Box<[Mutex<Lru<K, V>>]>,
    hasher: RandomState,
}

impl<K: Hash + Eq + Clone, V: Clone> Cache<K, V> {
    pub fn builder() -> CacheBuilder {
        CacheBuilder::default()
    }

    pub fn get(&self, key: &K) -> Option<V> {
        self.shard(key).lock().get(key).cloned()
    }

    pub fn set(&self, key: K, value: V) {
        self.shard(&key).lock().insert(key, value);
    }

    fn shard(&self, key: &K) -> &Mutex<Lru<K, V>> {
        let i = self.hasher.hash_one(key) as usize % self.shards.len();
        &self.shards[i]
    }
}

#[derive(Default)]
pub struct CacheBuilder {
    capacity: usize,
    shards: usize,
    policy: Policy,
}
EOF
  put src/lru.rs <<'EOF'
use std::collections::HashMap;
use std::hash::Hash;

pub struct Lru<K, V> {
    map: HashMap<K, (V, u64)>,
    clock: u64,
    capacity: usize,
}

impl<K: Hash + Eq + Clone, V> Lru<K, V> {
    pub fn get(&mut self, key: &K) -> Option<&V> {
        self.clock += 1;
        let entry = self.map.get_mut(key)?;
        entry.1 = self.clock;
        Some(&entry.0)
    }

    pub fn insert(&mut self, key: K, value: V) {
        if self.map.len() >= self.capacity {
            self.evict_oldest();
        }
        self.clock += 1;
        self.map.insert(key, (value, self.clock));
    }

    fn evict_oldest(&mut self) {
        if let Some(k) = self.map.iter().min_by_key(|(_, (_, t))| *t).map(|(k, _)| k.clone()) {
            self.map.remove(&k);
        }
    }
}
EOF
  commit "Priya Raman" 2 "init: sharded lru cache"
  put src/ttl.rs <<'EOF'
use std::time::{Duration, Instant};

pub struct Expiring<V> {
    pub value: V,
    pub deadline: Instant,
}

impl<V> Expiring<V> {
    pub fn new(value: V, ttl: Duration) -> Self {
        Self { value, deadline: Instant::now() + ttl }
    }

    pub fn is_live(&self) -> bool {
        Instant::now() < self.deadline
    }
}
EOF
  commit "Priya Raman" 20 "feat: ttl entries"
  put benches/get_set.rs <<'EOF'
use criterion::{Criterion, criterion_group, criterion_main};
use ferrous::Cache;

fn get_set(c: &mut Criterion) {
    let cache = Cache::builder().build();
    c.bench_function("set/small", |b| b.iter(|| cache.set(1u64, [0u8; 64])));
    c.bench_function("get/hot", |b| b.iter(|| cache.get(&1u64)));
}

criterion_group!(benches, get_set);
criterion_main!(benches);
EOF
  commit "Sam Achterberg" 44 "bench: criterion get/set"
  git push -q -u origin main 2>/dev/null

  git switch -qc perf/arena-alloc
  git push -q -u origin perf/arena-alloc 2>/dev/null
  put src/arena.rs <<'EOF'
//! Slab arena for cache values: one allocation per size class instead of
//! one per entry. Values over 64 KiB go to the global allocator.

pub const MAX_SLOT: usize = 64 * 1024;

pub struct Arena {
    classes: Vec<SizeClass>,
}

struct SizeClass {
    slot: usize,
    chunks: Vec<Box<[u8]>>,
    free: Vec<u32>,
}

impl Arena {
    pub fn new() -> Self {
        let classes = (6..=16).map(|p| SizeClass::new(1 << p)).collect();
        Self { classes }
    }

    pub fn class_for(&self, len: usize) -> Option<usize> {
        (len <= MAX_SLOT).then(|| len.next_power_of_two().trailing_zeros().saturating_sub(6) as usize)
    }
}

impl SizeClass {
    fn new(slot: usize) -> Self {
        Self { slot, chunks: Vec::new(), free: Vec::new() }
    }
}
EOF
  perl -pi -e 's|^mod lru;|mod arena;\nmod lru;|' src/lib.rs
  commit "Sam Achterberg" 150 "perf: slab arena for values"
  printf '\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn reuses_freed_slots() {}\n}\n' >>src/arena.rs
  commit "Sam Achterberg" 171 "test: arena slot reuse"

  # Someone else pushed to the branch meanwhile: behind by one.
  local other="$demo/tmp-ferrous"
  rm -rf "$other"
  git clone -q -b perf/arena-alloc "$remotes/ferrous.git" "$other"
  (cd "$other" && printf '\n## Benchmarks\n\n`cargo bench --bench get_set`\n' >>README.md && commit "Priya Raman" 180 "docs: how to run the benches" && git push -q 2>/dev/null)
  rm -rf "$other"
  git fetch -q
}

