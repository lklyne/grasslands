  commit "Priya Raman" 30 "docs: starlight site"
  put src/content/docs/guides/sharding.md <<'EOF'
---
title: Sharding
---

Each key hashes to one shard, and each shard has its own lock. More shards
means less contention and slightly worse eviction accuracy.
EOF
  put src/content/docs/reference/config.md <<'EOF'
---
title: Configuration
---

| Option     | Default | Meaning                          |
| ---------- | ------- | -------------------------------- |
| `capacity` | 65536   | Entries across all shards        |
| `shards`   | 16      | Independent locks                |
| `policy`   | `Lru`   | What a full shard drops first    |
EOF
  commit "Jules Moreau" 60 "docs: sharding guide"
  git push -q -u origin main 2>/dev/null
  git switch -qc docs/eviction-guide
  put src/content/docs/guides/eviction.md <<'EOF'
---
title: Eviction policies
---

When a shard is full, ferrous has to drop something. Which entry goes is
the policy's job.

## LRU

The default. Drops the entry read least recently. Good when recent reads
predict the next ones, which is most request caches.

```rust
Cache::builder().policy(Policy::Lru)
```

## LFU

Drops the entry read least often. Better for skewed workloads where a
small set of keys stays hot for hours.
EOF
}

for w in $(herdr workspace list | jq -r '.result.workspaces[].workspace_id'); do
  herdr workspace close "$w" --group >/dev/null 2>&1 || true # worktrees go with their repo
done
rm -rf "${demo:?}"
mkdir -p "$projects"
( seed_tidepool )
( seed_ferrous )
( seed_atlas )
unset GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM

# --- herdr session ---------------------------------------------------------


pane_of() { jq -r "$1"; }
paint() { herdr pane run "$1" "exec $show $here/demo/$2.txt" >/dev/null; }
agent() { # agent <pane> <kind> <name> <state> <title>
  herdr pane report-agent "$1" --source demo --agent "$2" --state "$4" >/dev/null
  herdr pane report-metadata "$1" --source demo --agent "$2" --title "$5" >/dev/null
  herdr agent rename "$1" "$3" >/dev/null
}
split() { herdr pane split "$1" --direction "$2" --ratio "$3" --cwd "$4" --no-focus | pane_of .result.pane.pane_id; }
settle() { # let the shell reach its prompt before typing into it
  herdr pane wait-output "$1" --match "→" --timeout 5000 >/dev/null 2>&1 || true
}

worktree() { # worktree <dir> <branch> <label>: a linked workspace on <branch>
  git -C "$tp" worktree add -q "$projects/$1" "$2"
  herdr worktree open --cwd "$tp" --path "$projects/$1" --label "$3" --no-focus --trust-repository
}

tp="$projects/tidepool"
ws=$(herdr workspace create --cwd "$tp" --label tidepool --no-focus)
tp_ws=$(echo "$ws" | pane_of .result.workspace.workspace_id)
checkout=$(echo "$ws" | pane_of .result.root_pane.pane_id)
herdr tab rename "$(echo "$ws" | pane_of .result.tab.tab_id)" checkout >/dev/null
server=$(split "$checkout" right 0.62 "$tp")
shell=$(split "$server" down 0.55 "$tp")
for p in "$checkout" "$server" "$shell"; do settle "$p"; done
paint "$checkout" checkout
agent "$checkout" claude checkout working "Itemize checkout total"
paint "$server" tidepool-dev
herdr pane rename "$server" "pnpm dev" >/dev/null
herdr pane run "$shell" "conda deactivate 2>/dev/null; clear; git status --short" >/dev/null

wt=$(worktree tidepool-webhooks feat/stripe-webhooks stripe-webhooks)
webhooks=$(echo "$wt" | jq -r '[.. | objects | select(has("pane_id")) | .pane_id][0]')
settle "$webhooks"
paint "$webhooks" webhooks
agent "$webhooks" codex webhooks blocked "Stripe webhook route"

wt=$(worktree tidepool-tz fix/timezone-drift timezone-drift)
tz=$(echo "$wt" | jq -r '[.. | objects | select(has("pane_id")) | .pane_id][0]')
settle "$tz"
paint "$tz" tz-fix
perl -pi -e 's|format\(date, "yyyy-MM-dd"\)|formatInTimeZone(date, tz, "yyyy-MM-dd")|; s|toDateKey\(date: Date\)|toDateKey(date: Date, tz: string)|' "$projects/tidepool-tz/src/lib/dates.ts"
agent "$tz" claude tz-fix working "Timezone date keys"
herdr pane report-agent "$tz" --source demo --agent claude --state idle >/dev/null

fr="$projects/ferrous"
git -C "$fr" switch -q perf/arena-alloc
ws=$(herdr workspace create --cwd "$fr" --label ferrous --no-focus)
arena=$(echo "$ws" | pane_of .result.root_pane.pane_id)
herdr tab rename "$(echo "$ws" | pane_of .result.tab.tab_id)" bench >/dev/null
tests=$(split "$arena" right 0.58 "$fr")
settle "$arena"; settle "$tests"
paint "$arena" arena
agent "$arena" claude arena-bench idle "Arena allocator benchmarks"
paint "$tests" ferrous-test
herdr pane rename "$tests" "nextest" >/dev/null

at="$projects/atlas-docs"
ws=$(herdr workspace create --cwd "$at" --label atlas-docs --no-focus)
docs=$(echo "$ws" | pane_of .result.root_pane.pane_id)
herdr tab rename "$(echo "$ws" | pane_of .result.tab.tab_id)" guides >/dev/null
astro=$(split "$docs" down 0.7 "$at")
settle "$docs"; settle "$astro"
paint "$docs" docs
agent "$docs" claude docs working "Eviction policies guide"
paint "$astro" atlas-dev
herdr pane rename "$astro" "astro dev" >/dev/null

herdr workspace focus "$tp_ws" >/dev/null
herdr agent focus checkout >/dev/null

echo "demo-scene: ready in session $HERDR_SESSION"
echo "  RT_SESSION=$HERDR_SESSION scripts/dev-run cargo run -p app"
